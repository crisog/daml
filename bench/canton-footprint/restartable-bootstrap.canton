// The startup script of the sandbox command in the Canton 3.7.4 release
// (sandbox/bootstrap.canton in the jar), with one change: a participant that
// kept its state reconnects to its synchronizer. The release script connects it
// and proposes its trust certificate again, which the topology state rejects.
import com.digitalasset.canton.config.RequireTypes.PositiveInt
import com.digitalasset.canton.version.ProtocolVersion

val protocol = ProtocolVersion.forSynchronizer

case class SyncDef(
    mediator: com.digitalasset.canton.console.LocalMediatorReference,
    sequencer: com.digitalasset.canton.console.LocalSequencerReference,
    name: String,
)

val syncDefs = mediators.local
  .zip(sequencers.local)
  .zipWithIndex
  .map { case ((m, s), i) => SyncDef(m, s, s"synchronizer-${i + 1}") }

val featureFlag = Seq(
  SynchronizerTrustCertificate.ParticipantTopologyFeatureFlag.EnableMultiSynchronizer
)

syncDefs.foreach { syncDef =>
  val staticSynchronizerParameters = StaticSynchronizerParameters.defaults(
    syncDef.sequencer.config.crypto,
    protocol,
    topologyChangeDelay = NonNegativeFiniteDuration.Zero,
  )
  val synchronizerOwners = Seq(syncDef.sequencer, syncDef.mediator)
  // Returns the existing synchronizer when the sequencer and the mediator kept their state.
  val synchId = bootstrap.synchronizer(
    syncDef.name,
    Seq(syncDef.sequencer),
    Seq(syncDef.mediator),
    synchronizerOwners,
    PositiveInt.one,
    staticSynchronizerParameters,
  )

  participants.local.foreach { p =>
    if (p.synchronizers.is_registered(syncDef.name)) {
      p.synchronizers.reconnect(syncDef.name)
    } else {
      p.synchronizers.connect_local(syncDef.sequencer, syncDef.name)
      p.topology.synchronizer_trust_certificates.propose(
        p,
        synchId.logical,
        featureFlags = featureFlag,
      )
    }
  }
}

participants.local.foreach { p =>
  println(
    s"${p.name} listening at ports: ${p.config.ledgerApi.port.unwrap}(gRPC) and ${p.config.httpLedgerApi.port.unwrap}(HTTP)"
  )
}

println("Canton sandbox is ready.")
